{
  "name": "referenceforge",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "start:onchain": "node src/onchain-server.mjs",
    "test:onchain": "node --test test/onchain.test.mjs",
    "bench:onchain": "node tools/benchmark-onchain.mjs",
    "bench:onchain:live": "node tools/benchmark-onchain-live.mjs",
    "check:onchain:oracle": "python tools/onchain-reference-oracle.py",
    "render:onchain": "node tools/render-onchain-miner.mjs",
    "build:onchain:worker": "wrangler deploy --config deploy/onchain.wrangler.jsonc --dry-run --outdir ../dist/onchain-worker",
    "dev:onchain:worker": "wrangler dev --config deploy/onchain.wrangler.jsonc --local --ip 127.0.0.1 --port 8791",
    "smoke:onchain:worker": "node tools/smoke-onchain-worker.mjs",
    "audit:onchain:bundle": "node tools/audit-onchain-bundle.mjs",
    "prepare:onchain:deploy": "node tools/prepare-onchain-deployment.mjs",
    "prepare:unified:deploy": "node tools/prepare-unified-deployment.mjs",
    "build:unified:worker": "wrangler deploy --config deploy/unified.wrangler.jsonc --dry-run --outdir ../dist/unified-worker",
    "dev:unified:worker": "wrangler dev --config deploy/unified.wrangler.jsonc --local --ip 127.0.0.1 --port 8792",
    "audit:unified:bundle": "node tools/audit-unified-bundle.mjs",
    "smoke:unified": "node tools/smoke-unified.mjs",
    "update:miner:check": "node tools/update-miner.mjs --check",
    "update:miner": "node tools/update-miner.mjs --interactive",
    "update:miner:status": "node tools/update-miner.mjs --status",
    "prepare:expanded:deploy": "node tools/prepare-expanded-deployment.mjs",
    "build:expanded:worker": "wrangler deploy --config deploy/expanded.wrangler.jsonc --dry-run --minify --outdir ../dist/expanded-worker",
    "dev:expanded:worker": "wrangler dev --config deploy/expanded.wrangler.jsonc --local --ip 127.0.0.1 --port 8793",
    "audit:expanded:bundle": "node tools/audit-expanded-bundle.mjs",
    "smoke:expanded": "node tools/smoke-expanded.mjs",
    "expand:miner:check": "node tools/expand-miner.mjs --check",
    "expand:miner": "node tools/expand-miner.mjs --interactive",
    "expand:miner:status": "node tools/expand-miner.mjs --status",
    "configure:alchemy": "node tools/configure-alchemy.mjs --interactive",
    "register:miner:check": "node tools/register-miner.mjs --check",
    "register:miner": "node tools/register-miner.mjs --interactive",
    "register:miner:status": "node tools/register-miner.mjs --status",
    "test": "node --test test/*.test.mjs",
    "build:wasm": "node tools/build-wasm.mjs",
    "test:wasm": "node tools/test-wasm.mjs",
    "test:rust": "cargo test --manifest-path wasm/comparator/Cargo.toml",
    "smoke:live": "node tools/smoke-live.mjs",
    "probe:interfaces": "node tools/probe-interfaces.mjs",
    "render:miner": "node tools/render-miner.mjs",
    "test:wazero": "cd wasm/runner && go run . ../../dist/referenceforge-comparator.wasm ../../reports/comparator-vectors.json ../../reports/wasm-wazero.json",
    "test:official": "node tools/check-official-reference.mjs",
    "bench:miner": "node tools/benchmark-miner.mjs",
    "bench:wasm": "node tools/benchmark-wasm.mjs",
    "bench:live": "node tools/benchmark-live.mjs",
    "bench:evaluator": "node tools/benchmark-evaluator.mjs",
    "bench:input-cache": "node tools/benchmark-input-cache.mjs",
    "check:public-bundle": "node tools/verify-public-bundle.mjs",
    "smoke:worker": "node tools/smoke-worker.mjs",
    "prepare:deploy": "node tools/prepare-deploy.mjs",
    "dev:worker": "wrangler dev --config deploy/wrangler.jsonc --local --port 8788",
    "build:worker": "wrangler deploy --config deploy/wrangler.jsonc --dry-run --outdir bundle",
    "register:wasm:check": "node tools/register-wasm.mjs --check",
    "register:wasm": "node tools/register-wasm.mjs --interactive",
    "register:wasm:status": "node tools/register-wasm.mjs --status",
    "prepare:weather:deploy": "node tools/prepare-weather-deployment.mjs",
    "build:weather:worker": "wrangler deploy --config deploy/weather.wrangler.jsonc --dry-run --minify --outdir ../dist/weather-worker",
    "audit:weather:bundle": "node tools/audit-weather-bundle.mjs",
    "dev:weather:worker": "wrangler dev --config deploy/weather.wrangler.jsonc --local --ip 127.0.0.1 --port 8794",
    "bench:weather": "node tools/benchmark-weather.mjs",
    "smoke:weather": "node tools/smoke-weather.mjs",
    "check:weather:source": "python tools/weather-source-oracle.py",
    "upgrade:weather:check": "node tools/upgrade-weather-miner.mjs --check",
    "upgrade:weather": "node tools/upgrade-weather-miner.mjs --interactive",
    "upgrade:weather:status": "node tools/upgrade-weather-miner.mjs --status",
    "check:network:quality": "node tools/check-network-quality.mjs",
    "smoke:routing": "node tools/smoke-routing.mjs",
    "refine:routing:check": "node tools/refine-routing-miner.mjs --check",
    "refine:routing": "node tools/refine-routing-miner.mjs --interactive",
    "refine:routing:status": "node tools/refine-routing-miner.mjs --status",
    "prepare:v2:deploy": "node tools/prepare-v2-deployment.mjs",
    "build:v2:worker": "wrangler deploy --config deploy/v2.wrangler.jsonc --dry-run --minify --outdir ../dist/v2-worker",
    "dev:v2:worker": "wrangler dev --config deploy/v2.wrangler.jsonc --local --ip 127.0.0.1 --port 8795",
    "audit:v2:bundle": "node tools/audit-v2-bundle.mjs",
    "smoke:v2": "node tools/smoke-v2.mjs",
    "check:v2:deployment": "node tools/verify-v2-deployment.mjs --intent-count 5",
    "audit:evaluator:v2": "node evaluator-v2/audit.mjs",
    "release:v2:check": "node tools/release-v2.mjs --check",
    "release:v2:deploy": "node tools/release-v2.mjs --deploy",
    "validate:v2": "node tools/validate-v2.mjs --local",
    "check:v2:bond": "node tools/inspect-v2-bond.mjs",
    "proof:wallet": "node tools/wallet-proof.mjs",
    "demo:wallet": "node tools/wallet-proof.mjs --demo",
    "build:comparator:v2": "node tools/build-comparator-v2.mjs",
    "check:comparator:v2": "node tools/check-comparator-v2.mjs",
    "bench:evaluator:v2": "node evaluator-v2/benchmark.mjs"
  },
  "devDependencies": {
    "@noble/hashes": "2.4.0",
    "ethers": "6.17.0",
    "wrangler": "4.152.0"
  }
}
