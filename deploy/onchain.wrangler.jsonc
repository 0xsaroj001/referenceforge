{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "referenceforge-onchain",
  "account_id": "35b26bd77aa13f5f1c008027783d71ca",
  "main": "onchain-worker.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "send_metrics": false,
  "assets": {
    "directory": "./onchain-public",
    "binding": "ONCHAIN_ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
